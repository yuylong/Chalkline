# 统一行尾为 LF：避免 Windows 开发者的 core.autocrlf 把 CRLF 写进仓库，
# 导致 gofmt -l / CI 格式化检查出现大量假阳性。
# 详见 docs/tech.md「行尾与格式化」。
* text=auto eol=lf

# Go 源码
*.go text eol=lf

# 前端与配置
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.sql text eol=lf
Makefile text eol=lf

# Windows 脚本保留 CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做行尾转换
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
