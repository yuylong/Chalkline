# Chalkline 部署环境变量（复制为 deploy/.env 后按需修改）。
# cp deploy/.env.example deploy/.env

# PostgreSQL（数据库密码必填）
POSTGRES_USER=chalk
POSTGRES_PASSWORD=change-me
POSTGRES_DB=chalkline

# 服务
CHALKLINE_LOG_LEVEL=info
VERSION=dev

# JWT 签名密钥（必填建议：openssl rand -hex 32；未设置将退化为进程内临时密钥，重启即全员掉线）
CHALKLINE_JWT_SECRET=change-me-openssl-rand-hex-32

# 首启 admin 引导（仅 users 表为空时生效；登录后请立即改密）
CHALKLINE_ADMIN_USERNAME=admin
CHALKLINE_ADMIN_PASSWORD=change-me-on-first-login

# TLS 证书 CN（自签名证书的域名；生产环境请直接替换 deploy/certs/ 下的证书文件）
CERT_CN=localhost
