# Chalkline 部署环境变量（复制为 deploy/.env 后按需修改）。
# cp deploy/.env.example deploy/.env

# PostgreSQL（数据库密码必填）
POSTGRES_USER=chalk
POSTGRES_PASSWORD=change-me
POSTGRES_DB=chalkline

# 服务
CHALKLINE_LOG_LEVEL=info
VERSION=dev

# ---- 容器镜像（完整引用，含 registry/tag；默认官方镜像与当前版本）----
# 阿里云等仅支持 latest 或需走镜像源的环境，可整体替换，例如：
#   POSTGRES_IMAGE=registry.cn-hangzhou.aliyuncs.com/xxx/postgres:latest
# 注意：postgres 大版本升级（如 16→19）后旧 pgdata 卷不兼容，需先迁移数据。
POSTGRES_IMAGE=postgres:19-alpine
NGINX_IMAGE=nginx:1.31-alpine
GO_IMAGE=golang:1.26-alpine
RUNTIME_IMAGE=alpine:3.23
NODE_IMAGE=node:24-alpine

# Go 模块代理（GOPROXY）：构建 api 镜像时拉取依赖使用；留空 = Go 默认（proxy.golang.org）。
# 国内网络建议设为 https://goproxy.cn,direct
GOPROXY=

# JWT 签名密钥（必填建议：openssl rand -hex 32；未设置将退化为进程内临时密钥，重启即全员掉线）
CHALKLINE_JWT_SECRET=change-me-openssl-rand-hex-32

# 静态凭据加密密钥（控制台「邮箱配置」保存 SMTP 密码时加密落库用；openssl rand -hex 32；
# 未设置回退 CHALKLINE_JWT_SECRET。注意：更换该密钥会使已保存的 SMTP 密码失效，需重新保存）
CHALKLINE_SECRET_KEY=

# 首启 admin 引导（仅 users 表为空时生效；登录后请立即改密）
CHALKLINE_ADMIN_USERNAME=admin
CHALKLINE_ADMIN_PASSWORD=change-me-on-first-login

# TLS 证书 CN（自签名证书的域名；生产环境请直接替换 deploy/certs/ 下的证书文件）
CERT_CN=localhost

# nginx 对外端口（宿主机映射端口；默认 80/443，被占用或非 root 部署时可改）
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ---- 集成（integration 模块，M2）：全部可选，默认关闭 ----

# 出站域名白名单：逗号分隔的 host 后缀；留空 = 拒绝一切出站（材料快照降级），"*" = 放行全部。
# 材料挂接只校验引用格式（不依赖外部系统），白名单仅约束 outline/redmine 的快照请求。
CHALKLINE_OUTBOUND_ALLOWLIST=

# Outline 知识库（材料标题快照；留空则不启用）
CHALKLINE_OUTLINE_BASE_URL=
CHALKLINE_OUTLINE_TOKEN=

# Redmine（issue 标题快照，单向出站、不回写状态；留空则不启用）
CHALKLINE_REDMINE_BASE_URL=
CHALKLINE_REDMINE_TOKEN=

# Webhook 事件订阅（全部工作流事件 POST 到该地址，带 X-Chalkline-Signature: sha256=<hmac> 签名头）
CHALKLINE_WEBHOOK_URL=
CHALKLINE_WEBHOOK_SECRET=

# SMTP 邮件通知（门禁待办/驳回/迭代收尾；收件人为下方列表）。
# 发件服务器也可在控制台「邮箱配置」页维护（保存即生效，字段留空沿用此处默认值）；
# 页面保存的密码加密落库（CHALKLINE_SECRET_KEY），环境变量密码仍是回退来源。
CHALKLINE_SMTP_HOST=
CHALKLINE_SMTP_PORT=25
CHALKLINE_SMTP_USERNAME=
CHALKLINE_SMTP_PASSWORD=
CHALKLINE_SMTP_FROM=
# TLS 模式：none（明文，默认）/ starttls（连接后升级，587 常用）/ tls（隐式 TLS，465 常用）
CHALKLINE_SMTP_TLS=none
# 跳过 TLS 证书校验（仅内网自签证书场景；公网 SMTP 必须为 false）
CHALKLINE_SMTP_TLS_SKIP_VERIFY=false
CHALKLINE_NOTIFY_EMAILS=

# outbox 投递轮询间隔
CHALKLINE_OUTBOX_INTERVAL=5s

# ---- 规模化（M3）----

# 评审超期阈值：awaiting_review 超过该时长未裁决 → 提醒评审人（gate.overdue）
CHALKLINE_REVIEW_SLA=24h

# 升级阈值：超过该时长 → 升级给产品 owner / admin（gate.escalated）；留空 = 3×SLA
CHALKLINE_REVIEW_ESCALATION=

# SLA 监控器扫描间隔
CHALKLINE_REVIEW_SCAN_INTERVAL=10m

# SSE 事件尾随轮询间隔（控制台实时刷新延迟）
CHALKLINE_EVENTS_INTERVAL=3s
